{
  "name": "@miblox/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "miblox-server": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@miblox/auth": "*",
    "@miblox/core": "*",
    "@miblox/luau": "*",
    "ws": "^8.18.0",
    "@miblox/scripting": "*"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12"
  }
}