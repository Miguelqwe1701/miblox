{
  "name": "@miblox/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run prebuild && vite build",
    "dev": "npm run prebuild && vite",
    "preview": "vite preview",
    "prebuild": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync(require.resolve('@miblox/wasm/miblox.wasm'),'public/miblox.wasm')\""
  },
  "dependencies": {
    "@miblox/core": "*",
    "@miblox/luau": "*",
    "@miblox/wasm": "*",
    "three": "^0.180.0",
    "@miblox/scripting": "*"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "vite": "^7.0.0",
    "typescript": "^5.6.0"
  }
}